# Content read API — minimal env (copy to .env)
#
#   cp .env.content-api.example .env

# --- API auth (share key with backend team) -----------------------------------
CONTENT_API_KEYS=dev-key-change-me
CONTENT_API_HOST=127.0.0.1
CONTENT_API_PORT=8080
CONTENT_API_CORS_ORIGINS=*

# --- AWS / DynamoDB -----------------------------------------------------------
AWS_DEFAULT_REGION=eu-west-1
PIPELINE_SUBJECT=Biology

# Local dev with AWS CLI profile (recommended on your laptop):
AWS_PROFILE=ibrary-dev
AWS_SDK_LOAD_CONFIG=1
# Do NOT set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY when using a profile.

# Render / hosted deploy — use IAM user keys instead of profile:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# DynamoDB Local only (comment out for prod AWS):
# DYNAMODB_ENDPOINT_URL=http://localhost:8000

ENVIRONMENT=development
