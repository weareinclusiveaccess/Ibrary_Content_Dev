# Content read API — optional overrides (does NOT replace .env)
#
#   cp .env.content-api.example .env.content-api
#
# Your existing .env is loaded first; values here fill in only missing keys.
# If you already have AWS_PROFILE / OPENAI keys in .env, keep using that file.

# --- API auth (share key with backend team) -----------------------------------
CONTENT_API_KEYS=153241c16a637248545322d946a235f4f3866df2943993baf5c5d54b83d1694d
CONTENT_API_HOST=127.0.0.1
CONTENT_API_PORT=8080
CONTENT_API_CORS_ORIGINS=*

# --- AWS / DynamoDB (skip any var already set in .env) ------------------------
AWS_DEFAULT_REGION=eu-west-1
PIPELINE_SUBJECT=Biology

# Local dev with AWS CLI profile (if not already in .env):
# AWS_PROFILE=ibrary-dev
# AWS_SDK_LOAD_CONFIG=1

# Render / hosted deploy — use IAM user keys instead of profile:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# DynamoDB Local only (comment out for prod AWS):
# DYNAMODB_ENDPOINT_URL=http://localhost:8000

# Production OpenAPI server URL (optional — used in Swagger "Servers" dropdown)
# CONTENT_API_PUBLIC_URL=https://ibrary-content-api-latest.onrender.com

ENVIRONMENT=development
