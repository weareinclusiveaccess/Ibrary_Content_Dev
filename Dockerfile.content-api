# Minimal image for the DynamoDB content read API (standalone — no pipeline or review UI).
#
# Installs only docker/content-api/requirements.txt (~30 MB), not pyproject.toml.
#
# Build:
#   docker build -f Dockerfile.content-api -t youruser/ibrary-content-api:latest .
#
# Run (prod DynamoDB):
#   docker run --rm -p 8080:8080 \
#     -e AWS_DEFAULT_REGION=eu-west-1 \
#     -e CONTENT_API_KEYS=your-secret-key \
#     -e AWS_ACCESS_KEY_ID=... -e AWS_SECRET_ACCESS_KEY=... \
#     youruser/ibrary-content-api:latest

FROM python:3.12-slim-bookworm

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    CONTENT_API_HOST=0.0.0.0 \
    CONTENT_API_PORT=8080 \
    ENVIRONMENT=production

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

COPY docker/content-api/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt \
    && rm /tmp/requirements.txt

COPY src/ibrary/__init__.py  src/ibrary/__init__.py
COPY src/ibrary/config.py    src/ibrary/config.py
COPY src/ibrary/serving/     src/ibrary/serving/

RUN useradd --create-home --shell /bin/bash --uid 1001 ibrary \
    && chown -R ibrary:ibrary /app
USER ibrary

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8080/health || exit 1

CMD ["uvicorn", "ibrary.serving.api:app", \
     "--host", "0.0.0.0", "--port", "8080", \
     "--proxy-headers", "--forwarded-allow-ips=*"]
