# LLM Provider API Keys
# At least one provider is required

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-opus-20240229

# Google Generative AI Configuration
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-pro

# Database Configuration
DATABASE_URL=sqlite:///./ibrary.db

# Redis Configuration (optional, for caching)
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# Application Settings
LOG_LEVEL=INFO
DEBUG=false
ENVIRONMENT=development

# Cost Control Settings
MAX_COST_PER_REQUEST=10.0
MAX_TOKENS_PER_REQUEST=100000

# Content Storage
STORAGE_BACKEND=local
STORAGE_PATH=./storage

# --- Content read API (DynamoDB) ---------------------------------------------
# Local dev: omit DYNAMODB_ENDPOINT_URL to use prod AWS; set for DynamoDB Local only.
# DYNAMODB_ENDPOINT_URL=http://localhost:8000
AWS_DEFAULT_REGION=eu-west-1
AWS_PROFILE=ibrary-dev
AWS_SDK_LOAD_CONFIG=1

CONTENT_API_HOST=127.0.0.1
CONTENT_API_PORT=8080
# Comma-separated keys for X-API-Key header; share with backend team
CONTENT_API_KEYS=dev-key-change-me
CONTENT_API_CORS_ORIGINS=*
PIPELINE_SUBJECT=Biology
