# LLM Provider API Keys
# At least one provider is required

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-opus-20240229

# Google Generative AI Configuration
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-pro

# PostgreSQL Configuration (Docker)
POSTGRES_USER=ibrary
POSTGRES_PASSWORD=ibrary_dev
POSTGRES_DB=ibrary
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ibrary:ibrary_dev@localhost:5432/ibrary

# DynamoDB Configuration
DYNAMODB_ENDPOINT_URL=http://localhost:8000
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# S3 Configuration (for images)
S3_BUCKET=ibrary-content
S3_ENDPOINT_URL=

# Redis Configuration (optional, for caching)
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# Application Settings
LOG_LEVEL=INFO
DEBUG=false
ENVIRONMENT=development

# Pipeline Configuration
ALIGNMENT_TOP_K=2
MAX_CONTEXT_TOKENS=8000
ALIGNMENT_CONFIDENCE_THRESHOLD=0.7

# Cost Control Settings
MAX_COST_PER_REQUEST=10.0
MAX_TOKENS_PER_REQUEST=100000

# Content Storage
STORAGE_BACKEND=local
STORAGE_PATH=./storage
