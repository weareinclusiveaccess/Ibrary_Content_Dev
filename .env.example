# LLM Provider API Keys
# At least one provider is required

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview
# Pipeline curation (JSON modules); optional reasoning_effort for GPT-5.x (none|minimal|low|medium|high|xhigh)
OPENAI_CURATION_MODEL=gpt-5.1
OPENAI_CURATION_REASONING_EFFORT=medium
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# LLM tracing (all pipeline OpenAI calls)
LLM_TRACE_ENABLED=true
LLM_TRACE_JSONL_PATH=data/logs/llm_traces.jsonl
LLM_TRACE_LOG_PROMPTS=false
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ibrary-pipeline

# Anthropic Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-opus-20240229

# Google Generative AI Configuration
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-pro

# PostgreSQL Configuration (Docker)
POSTGRES_USER=ibrary
POSTGRES_PASSWORD=ibrary_dev
POSTGRES_DB=ibrary
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ibrary:ibrary_dev@localhost:5432/ibrary
# SQL schema for pipeline tables (must match migrations)
POSTGRES_SCHEMA=ibrary

# Remote review DB (Neon IbraryContentReview / development branch)
# Use DIRECT connection (host without -pooler) for alembic + load_curated_to_postgres.py
# DATABASE_URL_REVIEW=postgresql://USER:PASS@ep-xxx.eu-west-2.aws.neon.tech/neondb?sslmode=require
# NEON_PROJECT_ID=mute-tooth-29855873
# NEON_BRANCH_DEVELOPMENT=br-twilight-tooth-abqnhg94

# Review portal (uv run python scripts/run_review_portal.py)
REVIEW_API_KEY=dev-review-key-change-me
REVIEW_API_HOST=127.0.0.1
REVIEW_API_PORT=8090

# DynamoDB Configuration
DYNAMODB_ENDPOINT_URL=http://localhost:8000
AWS_DEFAULT_REGION=eu-west-1
# AWS — use profile from ~/.aws/config (assumes content-dev role + MFA)
AWS_PROFILE=ibrary-dev
AWS_SDK_LOAD_CONFIG=1
AWS_DEFAULT_REGION=eu-west-1
# Do NOT set these when using a profile (they override the profile):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3 (extract step uploads textbook images)
S3_BUCKET=your-actual-bucket-name
S3_ENDPOINT_URL=


# Redis Configuration (optional, for caching)
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# Application Settings
LOG_LEVEL=INFO
DEBUG=false
ENVIRONMENT=development

# Subject (prompts and curated module metadata — change for other disciplines)
PIPELINE_SUBJECT=Biology
PIPELINE_SUBJECT_SLUG=biology
EDUCATION_SYSTEM_LABEL=Nigerian Senior Secondary School

# Pipeline Configuration
# 1 = legacy full-chunk curation; 2 = align top-10 → filter_relevance → excerpt curation
PIPELINE_VERSION=2
# v2 curate: PipelineOrchestrator (TextCurator → passthrough media/formula → assemble)
USE_CURATION_ORCHESTRATOR=true
# When filter_relevance leaves no excerpts, curate from curriculum only (not alignment chunks)
CURATE_CURRICULUM_ONLY_IF_NO_EXCERPTS=true
OPENAI_ENRICHMENT_MODEL=gpt-4o-mini
CURATION_MAX_IMAGES=5
CURATION_MAX_FORMULAS=12
MEDIA_TEXTBOOK_MIN_CONFIDENCE=0.6
# Run media/formula agents only when TextCurator emits placeholders (recommended)
ENRICHMENT_ENABLE_IMAGES=true
ENRICHMENT_ENABLE_FORMULAS=true
ENRICHMENT_AUTO_IMAGES=false
ENRICHMENT_AUTO_FORMULAS=false
# Hybrid chunk embeddings: first N chars of body + title/LO/summary (0 = metadata only)
EMBEDDING_BODY_MAX_CHARS=2000
ALIGNMENT_TOP_K=10
ALIGNMENT_CHAPTER_FILTER=true
ALIGNMENT_CHAPTER_FILTER_FALLBACK=true
MAX_CONTEXT_TOKENS=8000
ALIGNMENT_CONFIDENCE_THRESHOLD=0.7
OPENAI_RELEVANCE_MODEL=gpt-4o-mini
OPENAI_CURRICULUM_REFINE_MODEL=gpt-4o-mini
JUDGE_PASS_THRESHOLD=7.0
PROMPT_IMPROVEMENT_MIN_DELTA=0.25

# Cost Control Settings
MAX_COST_PER_REQUEST=10.0
MAX_TOKENS_PER_REQUEST=100000

# Content Storage
STORAGE_BACKEND=local
STORAGE_PATH=./storage
